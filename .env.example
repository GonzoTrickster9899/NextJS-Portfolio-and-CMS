# ─── Database (Neon Postgres) ─────────────────────────────────────────────────
# Pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://[user]:[password]@ep-[endpoint-id]-pooler.[region].aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Direct connection (no "-pooler") — used by Prisma for db push / migrations
DIRECT_URL="postgresql://[user]:[password]@ep-[endpoint-id].[region].aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ─── Auth (Neon Auth) ─────────────────────────────────────────────────────────
# Neon Console → your project → Auth → Configuration → Auth URL
NEON_AUTH_BASE_URL="https://ep-[endpoint-id].neonauth.[region].aws.neon.tech/neondb/auth"
# At least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
# Only this email can access /admin routes
ADMIN_EMAIL="your@email.com"

# ─── Object storage (Neon Object Storage, S3-compatible) ──────────────────────
# Neon Console → your project → Object storage. The bucket must be public_read.
NEON_STORAGE_ENDPOINT="https://br-[branch-id].storage.c-[n].[region].aws.neon.tech"
NEON_STORAGE_REGION="ap-southeast-1"
NEON_STORAGE_ACCESS_KEY_ID="nak_live_..."
NEON_STORAGE_SECRET_ACCESS_KEY="nsk_live_..."
NEON_STORAGE_BUCKET="portfolio-images"
# Optional: serve files from a different base URL (e.g. a CDN). Defaults to <endpoint>/<bucket>
# NEON_STORAGE_PUBLIC_URL=""

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Portfolio <noreply@yourdomain.com>"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
