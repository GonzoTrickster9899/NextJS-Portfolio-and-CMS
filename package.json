{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js db push",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js studio",
    "db:seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "postinstall": "prisma generate",
    "storage:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate-supabase-storage.ts",
    "db:copy-from-supabase": "tsx --env-file-if-exists=.env.local scripts/copy-supabase-data.ts",
    "storage:move-bucket": "tsx --env-file-if-exists=.env.local scripts/move-to-public-bucket.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@hookform/resolvers": "^3.9.0",
    "@neon/auth": "^0.8.2",
    "@prisma/client": "^5.16.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.19",
    "geist": "^1.7.0",
    "lucide-react": "^0.414.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.2",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "resend": "^3.4.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.16.2",
    "typescript": "^5"
  }
}
